# ─────────────────────────────────────────────────────────────────────────────
# AI & Crypto Pulse — Newsletter Agent
# Copy this file to .env and fill in your credentials
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic Claude API ─────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# ── Twitter / X API ──────────────────────────────────────────────────────────
# Requires at least the "Basic" tier ($100/mo) to read other users' tweets.
# Get your Bearer Token at: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=AAAA...

# ── Reddit API ───────────────────────────────────────────────────────────────
# Free — create an app at: https://www.reddit.com/prefs/apps
# Choose "script" type, set redirect URI to http://localhost
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=AI-Crypto-Newsletter/1.0

# ── Email (Gmail recommended) ─────────────────────────────────────────────────
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Paste that 16-character password below (NOT your normal Gmail password)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Optional: override SMTP settings (defaults work for Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
